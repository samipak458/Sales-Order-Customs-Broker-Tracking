<?xml version="1.0" encoding="utf-8"?>
<AxFormExtension xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
  <Name>WHSLoadTable_Extension</Name>
  <TargetForm>WHSLoadTable</TargetForm>
  <Design>
    <Pattern>DetailsFormMaster</Pattern>
    <PatternVersion>1.0</PatternVersion>
    <Controls>
      <AxFormControl>
        <Name>BrokerId</Name>
        <Type>String</Type>
        <FormControlExtension>
          <Name>BrokerId</Name>
          <ExtendedControl>TabPageDetails</ExtendedControl>
          <Controls>
            <AxFormControl>
              <Name>BrokerIdGroup</Name>
              <Type>Group</Type>
              <FormControlExtension>
                <Name>BrokerIdGroup</Name>
                <ExtendedControl>TabGeneral</ExtendedControl>
                <Controls>
                  <AxFormControl>
                    <Name>BrokerId</Name>
                    <Type>String</Type>
                    <DataSource>WHSLoadTable</DataSource>
                    <DataField>BrokerId</DataField>
                    <Label>Broker ID</Label>
                    <LookupButton>Auto</LookupButton>
                  </AxFormControl>
                </Controls>
              </FormControlExtension>
            </AxFormControl>
          </Controls>
        </FormControlExtension>
      </AxFormControl>
    </Controls>
  </Design>
  <DataSources>
    <AxFormDataSourceExtension>
      <Name>WHSLoadTable</Name>
      <DataSourceName>WHSLoadTable</DataSourceName>
      <Fields>
        <AxFormDataSourceField>
          <Name>BrokerId</Name>
          <DataField>BrokerId</DataField>
          <AllowEdit>Yes</AllowEdit>
        </AxFormDataSourceField>
      </Fields>
    </AxFormDataSourceExtension>
  </DataSources>
</AxFormExtension>
